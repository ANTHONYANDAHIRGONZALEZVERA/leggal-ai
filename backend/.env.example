POSTGRES_USER=leggal
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=leggal_ai
# Puerto de PostgreSQL en tu PC. Cámbialo (por ejemplo a 5433) si ya tienes otro
# PostgreSQL instalado en el 5432, y usa el mismo número en DATABASE_URL.
POSTGRES_PUERTO=5432
DATABASE_URL=postgresql://leggal:cambia_esta_clave@localhost:5432/leggal_ai
# development o production. Con production no se monta Swagger (/docs).
# Si no se define, la API asume desarrollo; en el servidor (B15) debe ir en production.
NODE_ENV=development
