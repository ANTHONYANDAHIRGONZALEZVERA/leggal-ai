# Variables del frontend. Copia este archivo como .env.local (no se sube a Git)
# y reinicia "npx expo start" después de cambiarlo.
# Todo lo que empieza con EXPO_PUBLIC_ queda dentro de la app: nunca pongas
# secretos aquí.

# Dirección del backend. Vacía = la app usa la API simulada.
# En el teléfono no sirve "localhost": usa la IP de tu PC, por ejemplo
# http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=

# true = usar la API simulada aunque haya URL (para trabajar sin backend).
EXPO_PUBLIC_API_MOCK=true
