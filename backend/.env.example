POSTGRES_USER=leggal
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=leggal_ai
# Puerto de PostgreSQL en tu PC. Cámbialo (por ejemplo a 5433) si ya tienes otro
# PostgreSQL instalado en el 5432, y usa el mismo número en DATABASE_URL.
POSTGRES_PUERTO=5432
DATABASE_URL=postgresql://leggal:cambia_esta_clave@localhost:5432/leggal_ai
# development o production. Con production no se monta Swagger (/docs).
# Si no se define, la API asume desarrollo; en el servidor (B15) debe ir en production.
NODE_ENV=development

# Firma de los tokens de acceso (JWT). Mínimo 32 caracteres, distinto en cada
# entorno y nunca en el repositorio. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=cambia_este_secreto_por_uno_de_al_menos_32_caracteres

# Duraciones del contrato de autenticación (docs/api/auth.md). Opcionales:
# si no se definen, se usan estos valores.
JWT_ACCESO_SEGUNDOS=900
REFRESCO_DIAS=30
REFRESCO_GRACIA_SEGUNDOS=30

# Versión vigente de los Términos y de la Política de privacidad. Se guarda al
# registrarse; si cambia, hay que pedir a cada persona que acepte de nuevo.
VERSION_TERMINOS=1.0
VERSION_PRIVACIDAD=1.0
